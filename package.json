{
  "name": "orbitlens-workspace-root",
  "version": "1.0.0",
  "private": true,
  "description": "OrbitLens Workspace Root Orchestrator",
  "scripts": {
    "dev": "node run-dev.mjs",
    "dev:all": "node run-dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend/web-backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend/web-backend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend/web-backend install"
  },
  "keywords": [
    "chandrayaan-2",
    "image-registration",
    "orbitlens",
    "isro"
  ],
  "author": "OrbitLens Team",
  "license": "ISC"
}
