# ── Service Environment ──────────────────────────────────────────────
ENV=development
PORT=8000
HOST=0.0.0.0

# ── Shared Internal Secret (Must match web-backend PROCESSING_SERVICE_API_KEY)
INTERNAL_API_KEY=shared_internal_orbitlens_secret_key_123

# ── Web Backend Callback URL ────────────────────────────────────────────
WEB_BACKEND_URL=http://localhost:5000

# ── Redis / Job Queue ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (S3 / MinIO) ─────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=orbitlens-imagery
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false

# ── Matcher Defaults ────────────────────────────────────────────────────
DEFAULT_MATCHER=classical
USE_GPU=false
MODEL_WEIGHTS_URI=

# ── Monitoring ──────────────────────────────────────────────────────────
SENTRY_DSN=
